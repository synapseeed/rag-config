{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "config",
    "services"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "qdrant_url",
        "default_branch",
        "reranker_url",
        "llm",
        "embedding"
      ],
      "additionalProperties": false,
      "properties": {
        "qdrant_url": {
          "type": "string",
          "format": "uri"
        },
        "reranker_url": {
          "type": "string",
          "format": "uri"
        },
        "default_branch": {
          "type": "string"
        },
        "qa_branch": {
          "type": "string"
        },
        "llm": {
          "type": "object",
          "required": ["provider", "model", "base_url"],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["ollama", "lmstudio", "openai", "anthropic"]
            },
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "api_key_env": {
              "type": ["string", "null"],
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        "embedding": {
          "type": "object",
          "required": ["provider", "model", "dimensions", "base_url"],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["ollama", "lmstudio", "openai"]
            },
            "model": {
              "type": "string"
            },
            "dimensions": {
              "type": "number",
              "minimum": 1
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "api_key_env": {
              "type": ["string", "null"],
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "name",
          "group",
          "path",
          "repo_slug",
          "package_json_name",
          "type",
          "qdrant_namespace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "Project/group key. Services sharing a group are treated as one project for cross-repo graph bridging, the global symbol map, and bulk operations (embed-all --group, doctor --group)."
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the service root on disk"
          },
          "repo_slug": {
            "type": "string"
          },
          "package_json_name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "shared-lib"
            ]
          },
          "primary_framework": {
            "type": "string",
            "enum": [
              "nestjs",
              "express",
              "nextjs",
              "react",
              "lib",
              "fastify"
            ]
          },
          "qdrant_namespace": {
            "type": "string",
            "pattern": "^qa__"
          },
          "rag": {
            "type": "object",
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "include_tests": {
                "type": "boolean"
              },
              "chunking": {
                "type": "object",
                "properties": {
                  "strategy": {
                    "type": "string",
                    "enum": [
                      "function",
                      "file"
                    ]
                  },
                  "max_tokens": {
                    "type": "number",
                    "minimum": 64,
                    "maximum": 2048
                  }
                }
              },
              "embedding": {
                "type": "object",
                "properties": {
                  "batch_size": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}