{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "config",
    "services"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "qdrant_url",
        "ollama_url",
        "embed_model",
        "embed_dimensions",
        "default_branch",
        "reranker_url"
      ],
      "properties": {
        "qdrant_url": {
          "type": "string",
          "format": "uri"
        },
        "ollama_url": {
          "type": "string",
          "format": "uri"
        },
        "reranker_url": {
          "type": "string",
          "format": "uri"
        },
        "embed_model": {
          "type": "string"
        },
        "embed_dimensions": {
          "type": "number",
          "minimum": 1
        },
        "default_branch": {
          "type": "string"
        },
        "qa_branch": {
          "type": "string"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "repo_slug",
          "package_json_name",
          "type",
          "qdrant_namespace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the service root on disk"
          },
          "repo_slug": {
            "type": "string"
          },
          "package_json_name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "shared-lib"
            ]
          },
          "primary_framework": {
            "type": "string",
            "enum": [
              "nestjs",
              "express",
              "nextjs",
              "react",
              "lib",
              "fastify"
            ]
          },
          "qdrant_namespace": {
            "type": "string",
            "pattern": "^qa__"
          },
          "rag": {
            "type": "object",
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "include_tests": {
                "type": "boolean"
              },
              "chunking": {
                "type": "object",
                "properties": {
                  "strategy": {
                    "type": "string",
                    "enum": [
                      "function",
                      "file"
                    ]
                  },
                  "max_tokens": {
                    "type": "number",
                    "minimum": 64,
                    "maximum": 2048
                  }
                }
              },
              "embedding": {
                "type": "object",
                "properties": {
                  "batch_size": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}