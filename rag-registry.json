{
  "$schema": "./schemas/registry.schema.json",
  "version": "2.0.0",
  "config": {
    "qdrant_url": "http://localhost:6333",
    "default_branch": "QA-16-03",
    "reranker_url": "http://localhost:8001",
    "llm": {
      "provider": "lmstudio",
      "model": "qwen3.6-35b-a3b",
      "base_url": "http://localhost:1234/v1",
      "api_key_env": null
    },
    "embedding": {
      "provider": "lmstudio",
      "model": "text-embedding-nomic-embed-text-v1.5",
      "dimensions": 768,
      "base_url": "http://localhost:1234/v1",
      "api_key_env": null
    }
  },
  "templates": {
    "backend-nestjs": {
      "rag": {
        "include": [
          "src/**/*.ts",
          "src/**/*.tsx",
          "src/**/*.js",
          "package.json",
          "Dockerfile",
          "docker-compose*.yml",
          "**/*.yaml",
          "**/*.yml"
        ],
        "exclude": [
          "node_modules/**",
          "dist/**",
          "coverage/**",
          "**/*.test.ts",
          "**/*.spec.ts",
          "**/*.mock.ts",
          "test/**",
          "__tests__/**",
          "**/generated/**",
          "**/__generated__/**",
          "**/*.snap",
          "**/*.map"
        ],
        "scan": {
          "mode": "priority",
          "exclude_generated": true,
          "max_file_size_kb": 512
        },
        "chunking": {
          "strategy": "function",
          "max_tokens": 512,
          "plugins": [
            "infra",
            "dto-contract",
            "entity-definition",
            "entity-usage",
            "api-contract",
            "module-contract",
            "service-client-contract",
            "query-contract",
            "dependency-graph",
            "ast",
            "babel",
            "text"
          ],
          "fallback_plugin": "text",
          "plugin_options": {
            "entity-usage": {
              "min_signal_count": 2,
              "require_entity_reference": true
            },
            "query-contract": {
              "min_signal_count": 2
            },
            "service-client-contract": {
              "min_signal_count": 1
            }
          }
        },
        "embedding": {
          "batch_size": 32
        }
      }
    }
  },
